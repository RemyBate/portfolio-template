---
import "../styles/globals.css";
import Navbar from "../components/Navbar";
import Footer from "../components/Footer";
import PageMeta from "../components/PageMeta";
import { getPageMetaKey } from "../lib/pageMeta";
import { translate } from "../lib/translations";

interface Props {
  title?: string;
  description?: string;
  page?: "home" | "about" | "projects" | "resume" | "contact";
}

const { pathname } = Astro.url;
const metaKey = Astro.props.page ?? getPageMetaKey(pathname);
const title =
  Astro.props.title ??
  (metaKey ? translate("en", `meta.${metaKey}.title`) : "RemyDev – Portfolio");
const description =
  Astro.props.description ??
  (metaKey
    ? translate("en", `meta.${metaKey}.description`)
    : "Web and application developer portfolio by Remy Bate Mbu, based in Germany.");
const canonicalUrl = new URL(pathname, "https://remydev.de").href;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Remy Bate Mbu",
  jobTitle: "Web Application Developer",
  url: "https://remydev.de",
  email: "remybatem@gmail.com",
  telephone: "+49-1520-8520081",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Mülheim an der Ruhr",
    addressCountry: "DE",
  },
  sameAs: [
    "https://github.com/RemyBate",
    "https://www.linkedin.com/in/mbu-remy-bate-38642b75",
  ],
  knowsAbout: [
    "Web Development",
    "Application Development",
    "Astro",
    "Next.js",
    "React",
    "TypeScript",
    "Tailwind CSS",
    "WordPress",
    "WooCommerce",
  ],
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "RemyDev Portfolio",
  url: "https://remydev.de",
  author: {
    "@type": "Person",
    name: "Remy Bate Mbu",
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Remy Bate Mbu" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_DE" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  </head>
  <body>
    <PageMeta client:load pathname={pathname} page={metaKey ?? undefined} />
    <Navbar client:load currentPath={pathname} />
    <main class="pt-20">
      <slot />
    </main>
    <Footer client:load />
  </body>
</html>
